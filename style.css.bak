/* MoveInReport — styles */
:root{
  --teal:#0f766e; --ink:#101828; --muted:#667085; --line:#e4e7ec;
  --bg:#f2f8f7; --card:#fff; --green:#0e9f6e; --red:#dc2626; --amber:#b45309;
}
*{box-sizing:border-box}
body{margin:0;font-family:'Segoe UI',system-ui,-apple-system,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5}
.hidden{display:none!important}

.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:.7rem 1.2rem}
.brand{font-weight:800;font-size:1.3rem;letter-spacing:-.02em}
.brand span{color:var(--teal)}
.site-header nav{display:flex;gap:1rem;align-items:center}
.site-header a{color:var(--muted);text-decoration:none;font-weight:600}
.btn-link{border:none;background:var(--teal);color:#fff;font-weight:700;padding:.45rem .9rem;border-radius:8px;cursor:pointer}
.badge{font-size:.7rem;font-weight:800;padding:.2rem .5rem;border-radius:99px;background:var(--green);color:#fff}

.wrap{max-width:1200px;margin:0 auto;padding:1.5rem 1.2rem}
.hero{text-align:center;padding:1.4rem 0 .9rem}
.hero h1{font-size:clamp(1.6rem,4vw,2.5rem);margin:0 0 .4rem;letter-spacing:-.03em}
.hero .sub{color:var(--muted);max-width:780px;margin:0 auto}
.hero-chips{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;margin-top:1rem}
.hero-chips span{background:#d9efe9;color:#0f766e;font-size:.8rem;font-weight:700;padding:.3rem .7rem;border-radius:99px}

.app-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-top:1.2rem}
@media(max-width:960px){.app-grid{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:1.2rem}
.panel h2{font-size:.95rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:1rem 0 .6rem}
.panel h2:first-child{margin-top:0}
.preview-title{margin-top:0}

.fields{display:grid;gap:.6rem}
.fields.three{grid-template-columns:1fr 1fr 1.4fr}
@media(max-width:700px){.fields.three{grid-template-columns:1fr}}
label{display:flex;flex-direction:column;gap:.25rem;font-size:.8rem;font-weight:600;color:var(--muted)}
input,select{border:1px solid var(--line);border-radius:8px;padding:.5rem .6rem;font-size:.95rem;font-family:inherit;background:#fff;color:var(--ink)}
input:focus,select:focus{outline:2px solid #bce3dd;border-color:var(--teal)}

.items-head{display:flex;justify-content:space-between;align-items:center;margin:1.1rem 0 .6rem}
.items-head h2{margin:0}
.btn-small{background:#dcf0ec;color:#0f766e;border:none;border-radius:8px;padding:.4rem .7rem;font-weight:700;cursor:pointer}
.btn-tiny{font-size:.68rem;border:1px solid var(--line);background:#f9fafb;border-radius:6px;padding:.15rem .45rem;cursor:pointer;margin-right:.3rem}

.area-block{border:1px solid var(--line);border-radius:10px;padding:.8rem;margin-bottom:.8rem;background:#fbfefd}
.area-head{display:grid;grid-template-columns:1.4fr 1.2fr 1fr 30px;gap:.5rem;align-items:end;margin-bottom:.5rem}
@media(max-width:700px){.area-head{grid-template-columns:1fr 1fr}.area-head label:nth-child(3){display:none}}
.area-notes{width:100%;border:1px solid var(--line);border-radius:8px;padding:.5rem;font-size:.9rem;font-family:inherit;min-height:38px}
.photo-row{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.5rem}
.photo-thumb{position:relative;width:72px;height:72px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#f3f4f6}
.photo-thumb img{width:100%;height:100%;object-fit:cover}
.photo-x{position:absolute;top:2px;right:2px;background:rgba(255,255,255,.9);border:none;border-radius:4px;width:18px;height:18px;font-size:.7rem;font-weight:800;cursor:pointer;color:var(--red)}
.add-photo{width:72px;height:72px;border:1.5px dashed #bce3dd;border-radius:8px;background:#f4faf9;color:var(--teal);font-size:.7rem;font-weight:800;cursor:pointer}
.row-x{border:none;background:#fee2e2;color:var(--red);border-radius:6px;cursor:pointer;font-weight:800;padding:.35rem;height:32px}

.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.1rem}
.btn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:.6rem 1rem;font-weight:700;cursor:pointer;font-size:.95rem}
.btn:hover{background:#f4f8f7}
.btn.primary{background:var(--teal);border-color:var(--teal);color:#fff}
.btn.primary:hover{background:#0b5f58}
.btn.big{width:100%;font-size:1.05rem;padding:.8rem}
.hint{color:var(--muted);font-size:.8rem}

/* report doc */
.report-doc{background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:1.3rem;font-size:.85rem;box-shadow:0 1px 4px rgba(16,24,40,.06)}
.rd-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2.5px solid var(--ink);padding-bottom:.5rem;margin-bottom:.7rem}
.rd-title{font-size:1.35rem;font-weight:900;letter-spacing:.12em}
.rd-sub{font-size:.72rem;letter-spacing:.22em;color:var(--muted)}
.rd-meta{text-align:right;font-size:.75rem;color:var(--muted)}
.rd-info{font-size:.8rem;margin-bottom:1rem;display:grid;gap:.2rem}
.rd-area{margin-bottom:1rem;page-break-inside:avoid}
.rd-area-name{font-weight:800;font-size:.95rem;border-bottom:1px solid var(--ink);padding-bottom:.15rem;margin-bottom:.3rem;display:flex;justify-content:space-between}
.rd-cond{font-size:.72rem;font-weight:800;padding:.1rem .5rem;border-radius:99px}
.cond-good{background:#d1f0e1;color:#065f46}
.cond-fair{background:#fef3e2;color:#92400e}
.cond-bad{background:#fee2e2;color:#991b1b}
.rd-notes{font-size:.8rem;color:#344054;white-space:pre-wrap}
.rd-photos{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem;margin-top:.4rem}
.rd-photos img{width:100%;height:88px;object-fit:cover;border:1px solid var(--line);border-radius:4px}
.rd-sign{display:flex;justify-content:space-between;margin-top:2rem;font-size:.75rem;gap:1rem}
.rd-foot{margin-top:1rem;border-top:1px solid var(--line);padding-top:.4rem;font-size:.62rem;color:var(--muted);text-align:center}

.marketing{margin-top:2.5rem}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.1rem}
.card h3{margin:.1rem 0 .4rem;font-size:1.02rem}
.card p{color:var(--muted);font-size:.9rem;margin:0}
.faq-item{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1rem 1.2rem;margin-bottom:.7rem}
.faq-item h3{margin:0 0 .35rem;font-size:1rem}
.faq-item p{margin:0;color:var(--muted);font-size:.92rem}
.cta-box{background:linear-gradient(135deg,#0f766e,#0b5f58);color:#fff;border-radius:16px;padding:1.6rem;margin-top:2rem}
.cta-box h2{margin:0 0 .6rem}
.cta-box ul{margin:0 0 .6rem;padding-left:1.2rem}
.once{color:#cdeee8;font-size:.85rem;margin:.4rem 0 .9rem}

.modal{position:fixed;inset:0;background:rgba(16,24,40,.55);display:flex;align-items:center;justify-content:center;z-index:100;padding:1rem}
.modal-card{background:#fff;border-radius:16px;padding:1.5rem;max-width:440px;width:100%;position:relative;max-height:90vh;overflow:auto}
.modal-x{position:absolute;top:.7rem;right:.7rem;border:none;background:#f2f4f7;border-radius:8px;width:30px;height:30px;cursor:pointer;font-weight:700}
.price{font-size:1.6rem;font-weight:900;margin:.2rem 0 .8rem}
.price span{font-size:.8rem;font-weight:600;color:var(--muted)}
.qr-box{display:flex;gap:1rem;align-items:center;justify-content:space-between}
.qr-box img{border:1px solid var(--line);border-radius:8px;background:#fff}
.pay-alt{color:var(--teal);font-weight:800;text-decoration:none;font-size:.9rem}
.pay-steps{margin:.8rem 0 0;padding-left:1.1rem;font-size:.85rem;color:var(--muted)}
.code-row{display:flex;gap:.5rem;margin-top:1rem}
.code-row input{flex:1}
.code-msg{font-size:.85rem;min-height:1.2rem;margin:.5rem 0 0;font-weight:700}
.code-msg.ok{color:var(--green)}
.code-msg.bad{color:var(--red)}
.saved-list{list-style:none;margin:0;padding:0}
.saved-list li{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding:.5rem .1rem;gap:.5rem}
.saved-list button{border:none;background:#dcf0ec;color:#0f766e;border-radius:6px;padding:.3rem .6rem;font-weight:700;cursor:pointer}

.site-footer{border-top:1px solid var(--line);margin-top:2.5rem;padding:1.2rem;text-align:center;color:var(--muted);font-size:.78rem}

@media print{
  body *{visibility:hidden}
  #doc,#doc *{visibility:visible}
  #doc{position:absolute;left:0;top:0;width:100%;border:none;box-shadow:none;padding:0}
  .rd-photos img{height:120px}
  @page{margin:12mm}
}
